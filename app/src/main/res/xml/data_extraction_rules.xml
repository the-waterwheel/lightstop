<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- Final, user-owned records only. Cache and no-backup storage stay out of backup. -->
        <include domain="file" path="parameter_records/" />
        <include domain="file" path="vignetting-calibration/" />
        <include domain="sharedpref" path="raw_light_meter_state.xml" />
        <include domain="sharedpref" path="raw_meter_calibration.xml" />
        <include domain="sharedpref" path="calibration_environment.xml" />
        <include domain="sharedpref" path="raw_light_meter_cameras.xml" />
        <include domain="sharedpref" path="film_latitude_state.xml" />
        <include domain="sharedpref" path="film_reciprocity_state.xml" />
        <include domain="sharedpref" path="parameter_record_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="parameter_records/" />
        <include domain="file" path="vignetting-calibration/" />
        <include domain="sharedpref" path="raw_light_meter_state.xml" />
        <include domain="sharedpref" path="raw_meter_calibration.xml" />
        <include domain="sharedpref" path="calibration_environment.xml" />
        <include domain="sharedpref" path="raw_light_meter_cameras.xml" />
        <include domain="sharedpref" path="film_latitude_state.xml" />
        <include domain="sharedpref" path="film_reciprocity_state.xml" />
        <include domain="sharedpref" path="parameter_record_settings.xml" />
    </device-transfer>
</data-extraction-rules>
